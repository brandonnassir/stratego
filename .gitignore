.venv/
# Phase 8 production corpus bytes: reproducible from the frozen contract by
# `python scripts/run_phase8_agent02.py --generate`, and far too large to be a
# report attachment. The manifest and digests that describe it are tracked.
# `data/stratego_phase8/` is the relocated canonical corpus root recorded in
# `data/warmstart_corpus_root.txt`; its bytes stay out of version control.
data/warmstart/
data/stratego_phase8/
# Phase 6b soak shards and worker state: production bytes, not report
# attachments. Compact Phase 6b reports stay tracked under reports/phase_6_data.
data/stratego_phase6b/
.phase6b_final_state/
# Local leftovers that must not appear as GitHub Desktop "changes".
stratego_project_docs 2/
reports/.Rhistory
instructions/phase_11_sequential_agent_plan.zip
# Phase 8 training checkpoints and Agent 4 engineering-run state: production
# data reproducible by `python scripts/run_phase8_agent04.py --full`; the
# JSON/CSV artifacts that describe them are tracked in reports/phase_8_data.
checkpoints/phase8/
# Phase 9 rollout shards, learner checkpoints, archive snapshots, and the
# Agent 1 evaluation bridge/game state: production data reproducible from the
# frozen phase9 contract; compact manifests/digests are tracked in
# reports/phase_9_data.
checkpoints/phase9/
data/phase9/
# Phase 10 Agent 1 harness stage dumps and later production selector/utility
# bytes: reproducible from the frozen phase10 contract; compact
# manifests/digests are tracked in reports/phase_10_data.
checkpoints/phase10/
data/phase10/
# Phase 10b fine-tuning checkpoints and rollout shards.
checkpoints/phase10b/
data/phase10b/
# Draft patch files are working material, not sealed artifacts.
*.patch
# Phase 11 harness stage dumps and any later belief-validation working state:
# reproducible from the frozen phase11 contract; compact manifests/digests
# are tracked in reports/phase_11_data.
checkpoints/phase11/
data/phase11/
# Phase 11B engineering-sprint bytes: the common belief corpus, the frozen
# C1 feature caches and the candidate checkpoints. Reproducible from the
# Phase 11B contract by `python scripts/run_phase11b_agent01.py --full`, plus
# `run_phase11b_agent03.py --stage cache` for the per-square C1 field caches
# and `run_phase11b_agent04.py --stage cache` for the fused raw+C1 inputs;
# the manifests, digests and metrics that describe them are tracked in
# reports/phase11b.
checkpoints/phase11b/
data/phase11b/
# Phase 12 read-only re-export of the accepted Phase 9 C1 checkpoint: a
# convenience copy with different bytes (81906f71…); the original at
# checkpoints/phase9/selfplay_c1_v1.pt (dfd698e5…) remains the only binding
# target, and the tracked phase12_search_candidate_v1.json records both.
checkpoints/phase12/phase9_c1_readonly_copy.pt
# Phase 11B harness stage caches: resumable working state, not deliverables.
reports/phase11b/.*_stages.json
__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store
*.tar.gz
*.pdf
# Phase 13 Agent 3 rehearsal hot checkpoints: working bytes of a reliability
# rehearsal, reproducible from `scripts/run_phase13_agent03.py`; the evidence
# that describes them is tracked under reports/phase13/agent03_evidence.
checkpoints/phase13_rehearsal/
# Phase 14 hot resume checkpoints: a bounded ring of ~10 MB working files on
# internal disk, rewritten every 15 minutes for 168 hours. The durable evidence
# lives on the external volume and in reports/phase13.
checkpoints/phase14/
# Phase 17 integration baseline (2026-08-27): the Phase 15/16 production bytes
# are reproducible working data, not deliverables, and are excluded on the same
# terms as phases 8-14 above. ~22.44 GiB. The compact Phase 16 candidate JSONs at
# the checkpoints/phase16 root stay tracked, as do all reports and manifests.
checkpoints/phase15/
data/phase15/
checkpoints/phase16/arms/

# Phase 17 Agent 4 rehearsal bytes. `checkpoints/phase17/rehearsal/` holds the
# paired checkpoints, exports and telemetry the bounded integration rehearsal
# produced -- 641 MiB of reproducible output whose *findings* live in
# reports/phase17/agent_04_*.json. The production run writes under
# checkpoints/phase17/<run-id>/ and is excluded for the same reason.
checkpoints/phase17/

# Phase 18 Gate G2 runtime artifacts (2026-09-02): the synthetic assay's
# per-seed outcome receipts, telemetry, held-out utility arrays and the three
# checkpoint objects, reproducible from the frozen contract by
# `python scripts/phase18_g2_setup_parity.py --run --seed-index K`. The
# results, binding ledger and per-seed summaries are tracked under
# reports/phase18. The G1 artifacts live outside the repository and are untouched.
artifacts/phase18/g2_setup_parity_v1/

# Phase 18 Gate G2 raw-actor confirmation runtime artifacts (2026-09-02): the
# bounded confirmation's per-seed outcome receipts, telemetry, held-out utility
# arrays (raw and EMA) and the three checkpoint objects, reproducible from the
# frozen contract by `python scripts/phase18_g2_raw_confirmation.py --run
# --seed-index K`. Results, replay, binding and per-seed summaries are tracked
# under reports/phase18.
artifacts/phase18/g2_raw_confirmation_v1/
